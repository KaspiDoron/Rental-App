# =============================================================================
# WheelDeal - environment configuration
# =============================================================================
# Copy this file to `.env.local` for local dev, or paste these into your host's
# dashboard (Vercel → Settings → Environment Variables) for production.
#
# The app runs fully in DEMO MODE with none of these set (in-memory data +
# deterministic mock AI). Add keys to switch on the real integrations.
#
# SECURITY: never commit a filled-in copy of this file. `.env*` is gitignored.
# The four tokens shared in chat should be rotated before use - treat them as
# compromised the moment they left a private channel.
# =============================================================================

# ---- LLM providers (server-side only; the app picks the first one present) ---
GEMINI_TOKEN=
GROQ_TOKEN=
OPENROUTER_TOKEN=
CEREBRAS_TOKEN=

# Which provider to prefer when several keys are set: groq | gemini | openrouter | cerebras
AI_PROVIDER=groq

# ---- Supabase (bootstrap - enables durable data + a persistent admin Key Vault)
# With these set, keys pasted in the admin panel are encrypted and saved to
# Supabase (survive serverless restarts). Without them, the app runs in demo
# mode and admin edits apply to the current instance only. Run supabase/schema.sql
# once in the SQL editor. SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL are
# interchangeable server-side; the service role key must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp Cloud API (official Meta Graph API - optional) -----------------
# Can be set here OR pasted later in the admin Key Vault. Leave blank to use
# compliant click-to-chat (wa.me) links instead of the Cloud API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any string you choose; enter the same value in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=

# ---- Auth / access control ---------------------------------------------------
# The single owner account (full control, AI co-manager access).
OWNER_EMAIL=kaspidoron@gmail.com
# Comma-separated management allowlist (the owner is always included).
ADMIN_EMAILS=kaspidoron@gmail.com
# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-please-use-a-32-byte-random-hex

# ---- Google (optional - can also be pasted in Admin -> Keys) -------------------
# Maps/Places/Geocoding server key: real vendors, precise addresses, reviews.
GOOGLE_MAPS_API_KEY=
# OAuth 2.0 Web client ID for "Continue with Google" sign-in.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Payments -------------------------------------------------------------------
# Recommended: Lemon Squeezy (Merchant of Record - works for individuals in
# Israel, no business entity needed, pays out via PayPal or bank wire).
# All of these can also be pasted later in Admin -> Keys.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ULTRA=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Alternative: Stripe (only if you can onboard with Stripe in your country).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Personal WhatsApp connector (Evolution API, self-hosted, free) ------------
# Users scan a QR in Profile to bargain from their OWN number. Deploy Evolution
# API (see GUIDE.md), then set its URL + the AUTHENTICATION_API_KEY you chose.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---- Google AdSense (free-tier ads; paid plans are ad-free) ---------------------
ADSENSE_CLIENT=

# ---- Email (optional - feedback also lands in the in-app Admin inbox) ----------
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=
