{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@/*": ["../../src/*"],
      "server-only": ["../../shims/server-only.ts"],
      "@wheeldeal/core": ["../../packages/core/index.ts"],
      "@wheeldeal/shared": ["../../packages/shared/index.ts"],
      "@wheeldeal/redis": ["../../packages/redis/index.ts"],
      "@wheeldeal/queues": ["../../packages/queues/index.ts"],
      "@wheeldeal/db": ["../../packages/db/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
