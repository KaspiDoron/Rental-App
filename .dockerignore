# Keep the Docker build context small. NOTE: every npm WORKSPACE directory must
# stay in the context (npm ci needs all workspace manifests) - so packages/*
# are NOT excluded; only heavy/irrelevant artifacts are.
node_modules
**/node_modules
.next
.git
.github
.vscode
dump.rdb
*.log
coverage
.env
.env.*
!.env.example
tests
test-results
playwright-report
playwright.config.ts
infra
Dockerfile
*.md
!GUIDE.md
